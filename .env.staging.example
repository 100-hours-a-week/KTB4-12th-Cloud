# Copy this file to .env.staging on the staging host.
# Never commit the copied file or real secret values.
COMPOSE_PROJECT_NAME=seonjalal-staging
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081

# Use immutable candidate tags such as develop-<git-sha>.
FE_IMAGE=peterj0117/seonjalal-fe
FE_VERSION=develop-0000000

BE_IMAGE=peterj0117/seonjalal-be
BE_VERSION=develop-0000000
BE_PORT=8080

MYSQL_IMAGE=mysql:8.4
DB_VOLUME_NAME=seonjalal-staging-db-data
DB_NAME=seonjalal_staging
DB_USER=seonjalal_staging
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

AWS_REGION=ap-northeast-2
PRODUCT_IMAGE_BUCKET=change-me-staging-bucket

# Generate unique values for staging. Never reuse production secrets.
JWT_SECRET_BASE64=change-me
JWT_ISSUER=seonjalal-staging
LOGIN_RATE_LIMIT_HMAC_SECRET_BASE64=change-me
CORS_ALLOWED_ORIGINS=https://staging.seonjalal.com

# Temporary configuration while the AI service is not deployed.
AI_PROFILE_BASE_URL=http://ai:8000
PROFILING_SERVICE_TOKEN=change-me
SCHEDULING_ENABLED=false
AI_PROFILE_SCHEDULING_ENABLED=false

# SQL output distorts load-test results and can expose data in logs.
SPRING_JPA_SHOW_SQL=false
