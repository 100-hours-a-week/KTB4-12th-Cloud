${gate_snippet}

// API 요청: 게이트 통과 후 /api 접두사를 제거해 ALB로 전달한다. 운영 api-path.js와 같은 규칙이다.
function handler(event) {
    var request = event.request;
    var blocked = gate(request);
    if (blocked) {
        return blocked;
    }
    if (request.uri === '/api/health') {
        request.uri = '/actuator/health';
    } else if (request.uri === '/api') {
        request.uri = '/';
    } else if (request.uri.indexOf('/api/') === 0) {
        request.uri = request.uri.slice(4);
    }
    return request;
}
