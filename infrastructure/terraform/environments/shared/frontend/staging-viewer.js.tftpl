function handler(event) {
    // 실제 접속 출구만 확인한다. 전달 헤더는 클라이언트가 위조할 수 있어 신뢰하지 않는다.
    var allowedIp = ${allowed_ipv4_json};
    var denied = {
        statusCode: 403,
        statusDescription: 'Forbidden',
        headers: {'cache-control': {value: 'no-store'}},
        body: 'Forbidden'
    };
    if (!allowedIp || !event.viewer || event.viewer.ip !== allowedIp) {
        return denied;
    }
    var request = event.request;
    if (!request || (request.method !== 'GET' && request.method !== 'HEAD')) {
        return denied;
    }
    var uri = request.uri;
    // API는 VPN 중계에서 ALB로 전달한다. 정적 CF로 API·다른 환경 경로를 전달하지 않는다.
    if (uri === '/api' || uri.indexOf('/api/') === 0 ||
        uri.indexOf('/frontend/') === 0 || uri.indexOf('..') !== -1 ||
        uri.indexOf('%') !== -1 || uri.indexOf('\\') !== -1) {
        return denied;
    }
    if (uri === '/index.html' || uri.indexOf('/assets/') === 0) {
        return request;
    }
    // 확장자가 없는 화면 경로의 새로고침은 SPA 진입 HTML로 처리한다.
    if (uri.charAt(0) === '/' && uri.substring(uri.lastIndexOf('/') + 1).indexOf('.') === -1) {
        request.uri = '/index.html';
        return request;
    }
    return denied;
}
