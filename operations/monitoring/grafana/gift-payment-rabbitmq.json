          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Work queue redeliveries / second",
      "description": "Redelivery rate is a retry signal, not a count of unique failed jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "seonjalal-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rate(rabbitmq_detailed_queue_messages_redelivered_total{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\",queue=~\"^gift[.](receipt[.]email|roulette|coupon[.]restore|payment[.](approval|cancellation)[.]recovery)[.]q$\"}[$__rate_interval]))",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "payment.events publish / confirm / return rate",
      "description": "Exchange counters are aggregate; they do not identify Outbox events or detect every missing fan-out binding. Aggregation preserves the BE draft: maximum per-node rate, NOT the cluster-wide sum. Confirm is broker acknowledgement, not business completion. Return does not detect every missing partial binding.",
      "datasource": {
        "type": "prometheus",
        "uid": "seonjalal-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (exchange, vhost) (rate(rabbitmq_detailed_exchange_messages_published_total{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\",exchange=\"payment.events\"}[$__rate_interval]))",
          "legendFormat": "published",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max by (exchange, vhost) (rate(rabbitmq_detailed_exchange_messages_confirmed_total{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\",exchange=\"payment.events\"}[$__rate_interval]))",
          "legendFormat": "confirmed",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "max by (exchange, vhost) (rate(rabbitmq_detailed_exchange_messages_unroutable_returned_total{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\",exchange=\"payment.events\"}[$__rate_interval]))",
          "legendFormat": "unroutable returned",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest DLQ message age",
      "description": "Derived from the oldest message timestamp; requires queue_metrics, filtered to the five DLQs. Empty-head timestamp 0 is excluded. No data can mean an empty queue, missing queue, or collection issue; check depth and scrape health.",
      "datasource": {
        "type": "prometheus",
        "uid": "seonjalal-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (queue) ((rabbitmq_detailed_queue_head_message_timestamp{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-dlq-age\",vhost=\"gift\",queue=~\"^gift[.](receipt[.]email|roulette|coupon[.]restore|payment[.](approval|cancellation)[.]recovery)[.]dlq$\"} > 0))",
          "legendFormat": "{{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      }
    },
