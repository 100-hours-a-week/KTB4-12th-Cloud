          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "수집 대상 큐 — Ready / Unacked",
      "description": "Agent의 결제·프로파일링·신고 큐 필터 범위 내 관측값. 실제 처리 성공·실패 또는 전체 큐 목록과 구분.",
      "datasource": {
        "type": "prometheus",
        "uid": "seonjalal-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (rabbitmq_detailed_queue_messages_ready{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\"})",
          "legendFormat": "ready · {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "max by (queue) (rabbitmq_detailed_queue_messages_unacked{cluster=\"seonjalal-v3\",environment=\"production\",job=\"rabbitmq-queues\",vhost=\"gift\"})",
          "legendFormat": "unacked · {{queue}}",
          "datasource": {
            "type": "prometheus",
            "uid": "seonjalal-prometheus"
          }
        }
      ],
      "fieldConfig": {
