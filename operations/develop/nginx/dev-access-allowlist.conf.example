# Develop EC2의 /etc/nginx/snippets/dev-access-allowlist.conf로 복사해 사용한다.
# 아래 문서용 IP를 실제 승인된 공인 IPv4/CIDR로 교체한다.
# 이 파일에는 실제 공인 IP가 들어가므로 Git에 커밋하지 않는다.

# EC2 내부에서 Host Nginx를 직접 확인할 때 사용할 Loopback을 허용한다.
allow 127.0.0.1;
allow ::1;

# 부트캠프 Wi-Fi 또는 승인된 부하 발생기 Network의 공인 IPv4를 허용한다.
allow 192.0.2.10/32;

# 위에서 명시적으로 허용하지 않은 Source는 HTTP 403으로 차단한다.
deny all;
