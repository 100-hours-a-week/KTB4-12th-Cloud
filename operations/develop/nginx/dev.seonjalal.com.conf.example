server {
    listen 80;
    server_name dev.seonjalal.com;

    # Keep port 80 closed in the Security Group during normal operation.
    # Temporarily allow it only for an HTTP certificate challenge, or use DNS validation.

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name dev.seonjalal.com;

    ssl_certificate /etc/letsencrypt/live/dev.seonjalal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.seonjalal.com/privkey.pem;

    # Develop은 승인된 네트워크에서만 접근한다.
    # 실제 공인 IP는 Git에 기록하지 않고 EC2의 이 파일에서 관리한다.
    # 같은 공인 IP를 공유하는 사용자는 구분할 수 없으므로 개인 단위 통제는 추후 VPN이 담당한다.
    include /etc/nginx/snippets/dev-access-allowlist.conf;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
