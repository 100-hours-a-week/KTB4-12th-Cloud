# 실제 파일은 Develop EC2의 /opt/seonjalal-develop/.env에만 생성하고 Git에 올리지 않는다.
HTTP_PORT=8080

# GitHub Actions가 게시한 Commit SHA 기반 Immutable Image 전체 URI를 사용한다.
FRONTEND_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/frontend:develop-0000000000000000000000000000000000000000
MAIN_BACKEND_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/backend:develop-main-backend-0000000000000000000000000000000000000000
PAYMENT_SERVER_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/backend:develop-payment-server-0000000000000000000000000000000000000000

DB_NAME=seonjalal_develop
DB_USER=seonjalal_develop

AWS_REGION=ap-northeast-2
PRODUCT_IMAGE_BUCKET=change-me
# PR #402 요구. ES 데이터 동기화/별도 검증 전 활성화 금지.
PRODUCT_SEARCH_ENABLED=false
JWT_ISSUER=seonjalal-v2-develop
CORS_ALLOWED_ORIGINS=https://seonjalal-v2-develop-runtime.YOUR_TAILNET.ts.net

# 실제 비밀값은 이 Secret의 JSON에 저장하고 배포 시점에만 임시 파일로 읽는다.
RUNTIME_SECRET_ID=/seonjalal/develop/runtime

# AI Runtime 배포 전에도 Spring 설정 계약을 만족하기 위한 Develop 전용 값이다.
AI_PROFILE_BASE_URL=http://ai:8000

# 현재 복구는 AI 기능을 유지한다. 비활성화 코드(#399)는 보류 상태다.
AI_CHAT_ENABLED=true
# AI 활성화 전 아래 설정과 Secret을 담당자와 확정하고 placeholder를 교체한다.
# 내부 결제 통신은 Host localhost가 아닌 Compose 서비스 이름을 사용한다.
PAYMENT_SERVER_BASE_URL=http://payment-server:8090
PAYMENT_CONNECT_TIMEOUT=1s
PAYMENT_COMMAND_TIMEOUT=3s
PAYMENT_QUERY_TIMEOUT=2s
AI_CHAT_BASE_URL=
AI_CHAT_CONNECT_TIMEOUT=
AI_CHAT_READ_TIMEOUT=
AI_CHAT_SSE_IDLE_TIMEOUT=
AI_CHAT_SSE_TOTAL_TIMEOUT=
AI_CHAT_SSE_MAX_CONNECTIONS=
CHAT_CONVERSATION_TOKEN_ISSUER=seonjalal-v2-develop-chat

# 프로파일링은 스케줄러 비활성 정책을 유지하고 클라이언트 설정만 전달.
AI_PROFILE_CONNECT_TIMEOUT=3s
AI_PROFILE_READ_TIMEOUT=10s
AI_PROFILE_BATCH_SIZE=100
AI_PROFILE_RECOVERY_BATCH_SIZE=50
AI_PROFILE_DISPATCH_INTERVAL=1m

# 선택 기능. Webhook/서비스 계정 비밀값은 아래 RUNTIME_SECRET JSON에만 저장.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

# 아래 키는 .env가 아니라 기존 RUNTIME_SECRET_ID의 JSON에 추가한다.
# PAYMENT_SERVER_API_KEY: main/payment 공통 내부 인증 키
# AI_CHAT_SERVICE_TOKEN: AI 담당자가 전달한 Develop 토큰
# CHAT_CONVERSATION_TOKEN_SECRET_BASE64: 대화 토큰 전용으로 생성한 키
# REDIS_PASSWORD: Redis 컨테이너와 Backend가 함께 쓰는 비밀번호(openssl rand -hex 32로 생성)
# SMTP_USERNAME, SMTP_PASSWORD: SES SMTP 자격 증명(seonjalal/shared/ses-smtp-local에서 복사)
# DISCORD_WEBHOOK_URL: 선택적인 오류 신고 Webhook
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64: 선택적인 Google 서비스 계정
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY는 주입하지 않고 EC2 IAM Role 사용.

# 선택값. 빈 값이면 Sentry 전송을 비활성화한다.
SENTRY_DSN=
