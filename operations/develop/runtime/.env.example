# 실제 파일은 Develop EC2의 /opt/seonjalal-develop/.env에만 생성하고 Git에 올리지 않는다.
HTTP_PORT=8080

# GitHub Actions가 게시한 Commit SHA 기반 Immutable Image 전체 URI를 사용한다.
FRONTEND_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/frontend:develop-0000000000000000000000000000000000000000
MAIN_BACKEND_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/backend:develop-main-backend-0000000000000000000000000000000000000000
PAYMENT_SERVER_IMAGE=000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/seonjalal/develop/backend:develop-payment-server-0000000000000000000000000000000000000000

DB_NAME=seonjalal_develop
DB_USER=seonjalal_develop

AWS_REGION=ap-northeast-2
PRODUCT_IMAGE_BUCKET=change-me
JWT_ISSUER=seonjalal-v2-develop
CORS_ALLOWED_ORIGINS=https://seonjalal-v2-develop-runtime.YOUR_TAILNET.ts.net

# 실제 비밀값은 이 Secret의 JSON에 저장하고 배포 시점에만 임시 파일로 읽는다.
RUNTIME_SECRET_ID=/seonjalal/develop/runtime

# AI Runtime 배포 전에도 Spring 설정 계약을 만족하기 위한 Develop 전용 값이다.
AI_PROFILE_BASE_URL=http://ai:8000

# 선택값. 빈 값이면 Sentry 전송을 비활성화한다.
SENTRY_DSN=
