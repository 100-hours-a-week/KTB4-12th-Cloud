server {
    listen 80;
    server_name staging.seonjalal.com;

    # Keep port 80 closed in the Security Group during normal operation.
    # Temporarily allow it only for an HTTP certificate challenge, or use DNS validation.

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name staging.seonjalal.com;

    ssl_certificate /etc/letsencrypt/live/staging.seonjalal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.seonjalal.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
