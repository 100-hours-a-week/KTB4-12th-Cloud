{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicas",
    "receiverReviewed",
    "image",
    "remoteWrite",
    "vhost",
    "sampleLimit"
  ],
  "properties": {
    "replicas": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "receiverReviewed": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "enum": [
            "prom/prometheus"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        }
      }
    },
    "remoteWrite": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[a-zA-Z0-9.:-]+/api/v1/write$"
        }
      }
    },
    "vhost": {
      "type": "string",
      "enum": [
        "gift"
      ]
    },
    "scrapeInterval": {
      "type": "string",
      "enum": [
        "15s",
        "30s",
        "60s"
      ]
    },
    "scrapeTimeout": {
      "type": "string",
      "enum": [
        "5s"
      ]
    },
    "sampleLimit": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 50000
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
