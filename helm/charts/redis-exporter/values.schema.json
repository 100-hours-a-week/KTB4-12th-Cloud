{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicas",
    "launchReviewed",
    "image"
  ],
  "properties": {
    "replicas": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "launchReviewed": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "const": "ghcr.io/oliver006/redis_exporter"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[0-9a-f]{64})$"
        }
      }
    }
  }
}
